rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "admin@grocery-shop-billing-system.firebaseapp.com";
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
